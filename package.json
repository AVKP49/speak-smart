    "content:validate": "node tools/validate.mjs",
    "content:stats": "node tools/validate.mjs --stats"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.11"
  }
}
